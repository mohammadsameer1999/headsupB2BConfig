x-common-config: &common-config
  networks:
    - hindalco
  deploy:
    resources:
      limits:
        memory: 1200m

x-microservice-config: &microservice-config
  <<: *common-config
  depends_on:
    discoveryserverheadsup:
      condition: service_started
    configserverheadsup:
      condition: service_started
    apigateway:
      condition: service_started
  environment:
    - MONGODB_HOST=165.232.187.211
    - MONGODB_PORT=25755
    - MONGODB_DATABASE=B2B
    - EUREKA_DEFAULT_ZONE=http://discoveryserverheadsup-ms:8761/eureka
    - JWT_SECRET=abcd123abcd123
    - JWT_EXPIRATION=3600000

services:
  nginx:
    image: nginx:latest
    ports:
      - "8080:80"
      - "443:443"
    volumes:
      - ./nginx.conf:/etc/nginx/nginx.conf:ro
      - /etc/letsencrypt:/etc/letsencrypt:ro
    depends_on:
      - apigateway
    networks:
      - hindalco

  discoveryserverheadsup:
    <<: *common-config
    image: "hcorptech/discoveryserverheadsup:0.0.1"
    container_name: discoveryserverheadsup-ms
    ports:
      - "8761:8761"

  configserverheadsup:
    <<: *common-config
    image: "hcorptech/configserverheadsup:0.0.1"
    container_name: configserverheadsup-ms
    ports:
      - "8888:8888"
    depends_on:
      discoveryserverheadsup:
        condition: service_started
    environment:
      - EUREKA_DEFAULT_ZONE=http://discoveryserverheadsup-ms:8761/eureka

  gatewayserviceheadsup:
    <<: *common-config
    image: "hcorptech/apigatewayb2b:0.0.1"
    container_name: gatewayserviceheadsup-ms
    ports:
      - "80:9090"
    depends_on:
      discoveryserverheadsup:
        condition: service_started
    environment:
      - SERVER_PORT=9090
      - EUREKA_DEFAULT_ZONE=http://discoveryserverheadsup-ms:8761/eureka
      - JAVA_TOOL_OPTION="-javaagent:/app/libs/opentelemetry-javaagent-1.33.5.jar"
      - OTEL_EXPORTER_OTLP_ENDPOINT="http://tempo:4317"
      - OTEL_METRICS_EXPORTER=none
      - OTEL_SERVICE_NAME="APIGATEWAY-trance"

  userheadsup:
    <<: *microservice-config
    image: "hcorptech/userheadsup:0.0.1"
    container_name: userheadsup-ms
    ports:
      - "8081:8081"
    environment:
      - SERVER_PORT=8081

  plantmicroservice:
    <<: *microservice-config
    image: "hcorptech/plantmicroservice:0.0.1"
    container_name: plantservice-ms
    ports:
      - "8082:8082"
    environment:
      - SERVER_PORT=8082

  helperheadsup:
    <<: *microservice-config
    image: "hcorptech/helperserviceb2b:0.0.1"
    container_name: helperheadsup-ms
    ports:
      - "8083:8083"
    environment:
      - SERVER_PORT=8083

  orderheadsup:
    <<: *microservice-config
    image: "hcorptech/orderheadsup:0.0.1"
    container_name: orderheadsup-ms
    ports:
      - "8086:8086"
    environment:
      - SERVER_PORT=8086

  uploadserviceb2b:
    <<: *microservice-config
    image: "hcorptech/uploadserviceb2b:0.0.1"
    container_name: uploadserviceb2b-ms
    ports:
      - "8095:8095"
    environment:
      - SERVER_PORT=8095

  readerservice:
    <<: *microservice-config
    image: "hcorptech/readerservice:0.0.1"
    container_name: readerservice-ms
    ports:
      - "8084:8084"
    environment:
      - SERVER_PORT=8084

  iotservice:
    <<: *microservice-config
    image: "docker.io/hcorptech/iotservice:0.0.1"
    container_name: iotservice-ms
    ports:
      - "8085:8085"
    environment:
      - SERVER_PORT=8085

  loki:
    <<: *common-config
    image: grafana/loki:2.8.0
    container_name: loki
    ports:
      - "3100:3100"
    volumes:
      - loki_data:/loki
    command: -config.file=/etc/loki/local-config.yaml

  grafana:
    <<: *common-config
    image: grafana/grafana:latest
    container_name: grafana
    ports:
      - "3000:3000"
    environment:
      - GF_SECURITY_ADMIN_PASSWORD=admin
    volumes:
      - grafana_data:/var/lib/grafana
      - ./provisioning:/etc/grafana/provisioning
    depends_on:
      - loki

  alloy:
    <<: *common-config
    image: grafana/alloy:v1.0.0
    volumes:
      - ./alloy-config.yml:/etc/alloy/config.alloy:ro
      - /var/run/docker.sock:/var/run/docker.sock
    command: run --server.http.listen-addr=0.0.0.0:12345 --storage.path=/var/lib/alloy/data /etc/alloy/config.alloy
    ports:
      - 12345:12345
    depends_on:
      - grafana

  prometheus:
    <<: *common-config
    image: prom/prometheus:latest
    container_name: prometheus
    ports:
      - "9009:9090"
    volumes:
      - ./monitoring/prometheus/prometheus.yml:/etc/prometheus/prometheus.yml
    command:
      - '--config.file=/etc/prometheus/prometheus.yml'

  tempo:
    <<: *common-config
    image: grafana/tempo:2.4.2
    container_name: tempo
    command: -config.file /etc/tempo-config.yml
    ports:
      - "3110:3100"
      - "4317:4317"
    volumes:
      - ./monitoring/tempo/tempo.yml:/etc/tempo-config.yml

networks:
  hindalco:
    driver: "bridge"

volumes:
  mongodb_data:
    driver: local
  loki_data:
    driver: local
  grafana_data:
    driver: local
  alloy_data:
    driver: local
